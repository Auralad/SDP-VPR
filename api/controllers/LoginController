<?php
class LoginController {
    private $db;
    
    public function __construct($db) {
        $this->db = $db;
        session_start();
    }
    
    public function showLoginForm() {
        if($this->isLoggedIn()) {
            $this->redirect('dashboard');
            return;
        }
        
        include 'frontend/login.php';
    }
    
    public function login() {
        if($_SERVER['REQUEST_METHOD'] !== 'POST') {
            $this->redirect('login');
            return;
        }
        
        $username = trim($_POST['username'] ?? '');
        $password = $_POST['password'] ?? '';
        
        $errors = $this->validateLogin($username, $password);
        
        if(empty($errors)) {
            $user = $this->findUser($username);
            
            if($user && password_verify($password, $user['passwort'])) {
                $this->createSession($user);        
                $this->redirect('dashboard');
                return;
            } else {
                $errors[] = "Ungültige Anmeldedaten";
            }
        }
        

        include 'frontend/login.php';
    }
    
    public function logout() {
        $this->destroySession();
        $this->redirect('login');
    }
    
    private function findUser($username) {
        $stmt = $this->db->prepare("SELECT id, username, passwort FROM users WHERE username = ?");
        $stmt->bind_param("s", $username);
        $stmt->execute();
        $result = $stmt->get_result();
        
        return $result->fetch_assoc();
    }
    
    private function createSession($user) {
        // Alte Session löschen
        session_regenerate_id(true);
        
        $_SESSION['user_id'] = $user['id'];
        $_SESSION['username'] = $user['username'];
        $_SESSION['logged_in'] = true;
        $_SESSION['login_time'] = time();
        $_SESSION['user_agent'] = $_SERVER['HTTP_USER_AGENT'];
        $_SESSION['ip_address'] = $_SERVER['REMOTE_ADDR'];
        
        // Optional: Session in DB speichern
        $this->saveSessionToDB($user['id'], session_id());
    }
    
    private function destroySession() {
        // Optional: Session aus DB löschen
        if(isset($_SESSION['user_id'])) {
            $this->deleteSessionFromDB($_SESSION['user_id']);
        }
        
        // Session löschen
        $_SESSION = array();
        
        // Session-Cookie löschen
        if(ini_get("session.use_cookies")) {
            $params = session_get_cookie_params();
            setcookie(session_name(), '', time() - 42000,
                $params["path"], $params["domain"],
                $params["secure"], $params["httponly"]
            );
        }
        
        session_destroy();
    }
    
    private function validateLogin($username, $password) {
        $errors = [];
        
        if(empty($username)) {
            $errors[] = "Benutzername erforderlich";
        }
        
        if(empty($password)) {
            $errors[] = "Passwort erforderlich";
        }
        
        // Weitere Validierungen...
        
        return $errors;
    }
    
    public function isLoggedIn() {
        return isset($_SESSION['logged_in']) 
               && $_SESSION['logged_in'] === true
               && $this->validateSession();
    }
    
    private function validateSession() {
        // Sicherheitsprüfungen
        if(!isset($_SESSION['user_agent'], $_SESSION['ip_address'])) {
            return false;
        }
        
        // Prüfe auf Session Hijacking
        if($_SESSION['user_agent'] !== $_SERVER['HTTP_USER_AGENT']) {
            return false;
        }
        
        // IP-Überprüfung (optional, kann bei dynamischen IPs problematisch sein)
        // if($_SESSION['ip_address'] !== $_SERVER['REMOTE_ADDR']) {
        //     return false;
        // }
        
        // Session Timeout (z.B. 2 Stunden)
        if(isset($_SESSION['login_time']) && (time() - $_SESSION['login_time'] > 7200)) {
            return false;
        }
        
        return true;
    }
    
    private function saveSessionToDB($userId, $sessionId) {
        $stmt = $this->db->prepare("INSERT INTO user_sessions (user_id, session_id, created_at) VALUES (?, ?, NOW())");
        $stmt->bind_param("is", $userId, $sessionId);
        $stmt->execute();
    }
    
    private function deleteSessionFromDB($userId) {
        $stmt = $this->db->prepare("DELETE FROM user_sessions WHERE user_id = ?");
        $stmt->bind_param("i", $userId);
        $stmt->execute();
    }
    
    private function logLogin($userId) {
        $stmt = $this->db->prepare("INSERT INTO login_logs (user_id, ip_address, user_agent, login_time) VALUES (?, ?, ?, NOW())");
        $stmt->bind_param("iss", $userId, $_SERVER['REMOTE_ADDR'], $_SERVER['HTTP_USER_AGENT']);
        $stmt->execute();
    }
    
    private function redirect($page) {
        header("Location: " . $this->getBaseUrl() . "/$page");
        exit();
    }
    
    private function getBaseUrl() {
        // Deine Basis-URL Logik
        return 'http://' . $_SERVER['HTTP_HOST'] . dirname($_SERVER['PHP_SELF']);
    }
}
?>